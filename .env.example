# Defaults work without creating .env. Copy this file to .env to customize.
LOCALSCRIBE_PORT=8090
# Use 0.0.0.0 to allow your phone on trusted private Wi-Fi.
LOCALSCRIBE_BIND=127.0.0.1
LOCALSCRIBE_THREADS=4
# CPU mode defaults. The optional compose.gpu.yaml profile overrides these.
LOCALSCRIBE_GPU_LAYERS=0
LOCALSCRIBE_MMPROJ_OFFLOAD=0
# Set to 1 after models have downloaded: missing files then fail without network.
LOCALSCRIBE_OFFLINE=0
# Optional persistent access code. Leave blank to generate a new one each start.
# If setting one, choose a long random value (at least 24 characters).
LOCALSCRIBE_TOKEN=
