# Defaults work without creating .env. Copy this file to .env to customize.
LOCALSCRIBE_PORT=8090
# Use 0.0.0.0 to allow your phone on trusted private Wi-Fi.
LOCALSCRIBE_BIND=127.0.0.1
# Inference threads for llama.cpp. Set this to your PHYSICAL core count, leaving
# a couple of cores for the OS. Measured on the IAM set: 4 threads 14.0 s/line,
# 8 threads 10.8 s/line, with identical output.
LOCALSCRIBE_THREADS=4
# Container ceilings. Raise both together with LOCALSCRIBE_THREADS; the defaults
# suit a 16 GB PC. LOCALSCRIBE_CPUS must be at least LOCALSCRIBE_THREADS.
LOCALSCRIBE_CPUS=4
LOCALSCRIBE_MEMORY=9g
# Token context for the handwriting model. A 1400px page costs roughly 1500
# prompt tokens and output is capped at 2048, so 6144 leaves clear headroom.
LOCALSCRIBE_ENGINE_CONTEXT=6144
# CPU mode defaults. The optional compose.gpu.yaml profile overrides these.
LOCALSCRIBE_GPU_LAYERS=0
LOCALSCRIBE_MMPROJ_OFFLOAD=0
# Set to 1 after models have downloaded: missing files then fail without network.
LOCALSCRIBE_OFFLINE=0
# Set to 0 to skip the text model used by "Fix with local AI" and save its RAM.
LOCALSCRIBE_CORRECTOR=1
# Run AI correction automatically once a page finishes transcribing. The result
# still only appears in the AI corrected/Compare tabs; it is never applied for you.
# Set to 0 to correct only when you press the button.
LOCALSCRIBE_AUTO_CORRECT=1
# Optional: a different GGUF chat model in models/ for "Fix with local AI".
# A larger model corrects more but uses more RAM and is slower on CPU.
LOCALSCRIBE_CORRECTOR_MODEL=
# Optional persistent access code. Leave blank to generate a new one each start.
# If setting one, choose a long random value (at least 24 characters).
LOCALSCRIBE_TOKEN=
